# ZAFTYS TSM — local environment
# Copy to .env.local and adjust.

# --- App ---
TSM_DEMO_UI=1
# SESSION_SECRET=change-me-to-a-long-random-string

# --- Postgres (docker compose) ---
DATABASE_URL=postgresql://tsm:tsm@localhost:5432/zaftys_tsm

# --- Redis (optional) ---
REDIS_URL=redis://localhost:6379

# --- MinIO / S3 (documents + logos) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=tsm
S3_SECRET_KEY=tsmsecret
S3_BUCKET=zaftys-tsm
S3_FORCE_PATH_STYLE=1

# --- Fleetbase (live mode when TSM_DEMO_UI=0) ---
# FLEETBASE_API_URL=http://localhost:8000
# FLEETBASE_API_KEY=

# --- Cron / webhook auth (GPS stale job, DLQ process, telematics ingest) ---
# TSM_CRON_SECRET=local-cron-secret
# TSM_GPS_STALE_MINUTES=15
# TSM_GPS_STALE_RAISE_EXCEPTION=0

# --- TranZfort (deferred) ---
# TRANZFORT_API_URL=
# TRANZFORT_API_KEY=
