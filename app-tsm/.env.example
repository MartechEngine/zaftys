# ZAFTYS TSM — local environment
# Copy to .env.local and adjust.

# --- App (LIVE-FIRST) ---
# Demo catalogs OFF unless TSM_DEMO_UI=1 (opt-in only).
TSM_DEMO_UI=0
# SESSION_SECRET=change-me-to-a-long-random-string

# --- Postgres (docker compose) ---
DATABASE_URL=postgresql://tsm:tsm@localhost:5432/zaftys_tsm

# --- Redis (optional) ---
REDIS_URL=redis://localhost:6379

# --- MinIO / S3 (documents + logos) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=tsm
S3_SECRET_KEY=tsmsecret
S3_BUCKET=zaftys-tsm
S3_FORCE_PATH_STYLE=1

# --- Execution backend (ADR-008 / S2) ---
# fleetbase = current pilot (default) · postgres = S3 stub (not ready) · ignored when TSM_DEMO_UI=1
# TSM_EXECUTION_BACKEND=fleetbase

# --- Fleetbase (transitional — used when TSM_EXECUTION_BACKEND=fleetbase) ---
FLEETBASE_API_URL=http://localhost:8000/v1
# FLEETBASE_API_KEY=

# --- Cron / webhook auth ---
# TSM_CRON_SECRET=local-cron-secret

# --- TranZfort bridge (auth-lite → Super Load) ---
# mock = local UI without calling prod RPCs (safe default)
TSM_TRANZFORT_BRIDGE_MODE=mock
# live = service_role RPCs (server only; never expose to browser)
# TSM_TRANZFORT_BRIDGE_MODE=live
# Public origin used for Google OAuth redirect_to (must match Supabase allowlist):
# TSM_PUBLIC_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Staging/prod desktop + web share the same TSM_PUBLIC_URL (never put service_role in the installer).
# Desktop shell: see app-tsm/desktop/README.md (Tauri → hosted URL).
# REMINDER: add Supabase keys before live Auth / live publish:
# TRANZFORT_SUPABASE_URL=https://tjpmkxgveuxvbtsqynwn.supabase.co
# TRANZFORT_ANON_KEY=          # L1 password + Google Auth (anon)
# TRANZFORT_SERVICE_KEY=       # bridge RPCs (server only)
# Ops: append Additional Redirect URL only (do not rotate Google Web client):
#   http://localhost:3000/api/auth/tranzfort/callback
# Or: npm run secrets:tranzfort  (needs Bitwarden dispatch project access)
# Offline places pack (TZ Flutter asset) for local catalog mirror:
# TRANZFORT_INDIAN_CITIES_PATH=C:/Users/Public/project/tranzfort-lab/app/TranZfort/assets/data/indian_cities.json
# Then: npm run catalog:sync
