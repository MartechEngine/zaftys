# ZAFTYS TSM — copy to .env.local for host-run Next.js
# See docs/app/ops/local-docker.md and ADR-007

# --- Modes ---
# Demo UI seed data (1) vs live Fleetbase orders (0 + FLEETBASE_API_KEY)
TSM_DEMO_UI=1

# --- ZAFTYS App DB (Docker Compose postgres) ---
DATABASE_URL=postgresql://tsm:tsm@localhost:5432/zaftys_tsm

# --- Cache / jobs ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO local S3) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minioadmin
S3_BUCKET=zaftys-tsm-docs
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=1

# --- Auth (dev HMAC session; NextAuth later) ---
SESSION_SECRET=change-me-to-a-long-random-string-32+
TRACK_TOKEN_SECRET=change-me-track-token-secret-32+

# --- Fleetbase (optional — live mode) ---
# FLEETBASE_API_URL=http://localhost:8000/v1
# FLEETBASE_API_KEY=

# --- TranZfort (optional — live network) ---
# TRANZFORT_SUPABASE_URL=
# TRANZFORT_SERVICE_KEY=
# LOAD_EXCHANGE_ADAPTER=demo

# --- Maps ---
# NEXT_PUBLIC_MAP_STYLE_URL=
# MAPBOX_TOKEN=
