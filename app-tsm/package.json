{
  "name": "app-tsm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d postgres redis minio minio-init",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:full": "docker compose -f infra/docker-compose.yml --profile full up -d --build",
    "test:fleetbase": "node scripts/test-fleetbase.mjs",
    "seed:fleetbase": "node scripts/seed-fleetbase-orders.mjs",
    "sync:tranzfort": "node scripts/sync-tranzfort.mjs",
    "secrets:tranzfort": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/load-bitwarden-tranzfort-secrets.ps1 -WriteEnvLocal",
    "smoke": "node scripts/smoke-local.mjs",
    "qa": "node scripts/smoke-local.mjs",
    "test:live": "node scripts/smoke-live.mjs",
    "test:auth": "node scripts/test-tsm-auth.mjs",
    "auth:create-user": "node scripts/create-auth-user.mjs",
    "db:wipe-demo": "node scripts/wipe-demo-app-documents.mjs",
    "db:pilot-cleanup": "node scripts/pilot-cleanup-tsm.mjs",
    "db:purge-smoke": "node scripts/purge-smoke-docs.mjs",
    "db:purge-fleetbase": "node scripts/purge-fleetbase-smoke.mjs",
    "db:inspect": "node scripts/inspect-local-docs.mjs",
    "catalog:sync": "node scripts/sync-tz-catalogs.mjs",
    "catalog:sync:materials": "node scripts/sync-tz-catalogs.mjs --materials-only",
    "catalog:sync:places": "node scripts/sync-tz-catalogs.mjs --places-only",
    "desktop:dev": "npm --prefix desktop run desktop:dev",
    "desktop:build": "npm --prefix desktop run desktop:build",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "test:e2e:north-star": "playwright test e2e/shipment-flow.spec.ts",
    "jobs:gps-stale": "node scripts/run-job.mjs gps-stale",
    "jobs:dlq-process": "node scripts/run-job.mjs dlq-process"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.2.0",
    "@mui/x-charts": "^9.10.0",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "lucide-react": "^1.24.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.10",
    "pdfkit": "^0.19.1",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
