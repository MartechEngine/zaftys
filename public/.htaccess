# Hostinger Apache  -  SPA fallback + protect crawler assets
# Copied into dist/ by Vite (public/) and deploy workflow

Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite API, static crawler files, or existing assets
  RewriteRule ^api/ - [L]
  RewriteRule ^config/ - [F,L]
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^sitemap\.php$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^og-image\.png$ - [L]
  RewriteRule ^favicon\.ico$ - [L]

  # Legacy flagship report slug → 2027-2036 (server 301 for crawlers)
  RewriteRule ^resources/reports/global-logistics-market-2026-2033/read/?$ /resources/reports/global-logistics-market-2027-2036/read [R=301,L]
  RewriteRule ^resources/reports/global-logistics-market-2026-2033/?$ /resources/reports/global-logistics-market-2027-2036 [R=301,L]

  # Existing files/dirs (Vite assets, images)  -  serve as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback
  RewriteRule ^ index.html [L]
</IfModule>

# Prefer HTML sneak-peek pages over raw PDF URLs in search
<IfModule mod_headers.c>
  <FilesMatch "\.pdf$">
    Header set X-Robots-Tag "noindex, follow"
  </FilesMatch>
</IfModule>

# Correct types for crawlers
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# Long-cache hashed Vite assets + static images/fonts (HTML stays short-lived)
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2|webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Optional: if a host still 500s on static sitemap.xml, uncomment:
# RewriteRule ^sitemap\.xml$ sitemap.php [L]
