# Hostinger Apache  -  SPA fallback + protect crawler assets
# Copied into dist/ by Vite (public/) and deploy workflow

Options -MultiViews
DirectoryIndex index.html
# Pretty URLs stay slash-free; prerender writes path/index.html (see prerender.mjs).
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Apex host. Canonicals and sitemap use zaftys.com.
  RewriteCond %{HTTP_HOST} ^www\.zaftys\.com$ [NC]
  RewriteRule ^ https://zaftys.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Never rewrite API, static crawler files, or existing assets
  RewriteRule ^api/ - [L]
  RewriteRule ^config/ - [F,L]
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^sitemap\.php$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^og-image\.png$ - [L]
  RewriteRule ^favicon\.ico$ - [L]

  # Block leftover or direct PDF URLs (gated files live under /files/market-reports/)
  RewriteRule ^files/market-reports/.*\.pdf$ - [F,L]
  RewriteRule ^reports/[^/]+\.pdf$ - [F,L]

  # Catalog page (prerendered reports/index.html). Match slash-free URL only so
  # /reports/ can 301 to /reports like every other route.
  RewriteCond %{DOCUMENT_ROOT}/reports/index.html -f
  RewriteRule ^reports$ reports/index.html [END]
  RewriteRule ^reports$ index.html [END]

  # Product pages  -  menu-aligned slugs (server 301 for crawlers)
  RewriteRule ^technology/?$ /zaftys-tms [R=301,L,QSA]
  RewriteRule ^platform/?$ /zaftys-tms [R=301,L,QSA]
  RewriteRule ^network/?$ /tranzfort-network [R=301,L,QSA]

  # Industry slug aliases
  RewriteRule ^industries/mining/?$ /industries/coal-mining [R=301,L,QSA]
  RewriteRule ^industries/retail/?$ /industries/retail-distribution [R=301,L,QSA]

  # Reports catalog moved off /resources/reports
  RewriteRule ^resources/reports/global-logistics-market-2026-2033/read/?$ /reports/global-logistics-market-2027-2036/read [R=301,L,QSA]
  RewriteRule ^resources/reports/global-logistics-market-2026-2033/?$ /reports/global-logistics-market-2027-2036 [R=301,L,QSA]
  RewriteRule ^reports/global-logistics-market-2026-2033/read/?$ /reports/global-logistics-market-2027-2036/read [R=301,L,QSA]
  RewriteRule ^reports/global-logistics-market-2026-2033/?$ /reports/global-logistics-market-2027-2036 [R=301,L,QSA]
  RewriteRule ^resources/reports/([^/]+)/read/?$ /reports/$1/read [R=301,L,QSA]
  RewriteRule ^resources/reports/([^/]+)/?$ /reports/$1 [R=301,L,QSA]
  RewriteRule ^resources/reports/?$ /reports [R=301,L,QSA]

  # Collapse trailing slashes (including dirs that exist for prerender HTML).
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Existing files (Vite assets, PDFs, images)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Prerendered HTML: /about → /about/index.html (URL stays /about)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)$ $1/index.html [END]

  # SPA catalog + report pages if prerender output is missing
  RewriteRule ^reports$ index.html [END]
  RewriteRule ^reports/([^/.]+)/read/?$ index.html [END,E=NOINDEX:1]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^reports/([^/.]+)/?$ index.html [END]

  # Known SPA routes only. Unknown paths fall through to a real 404.
  # Keep in sync with src/App.tsx.
  RewriteRule ^(about|zaftys-tms|services|fleet|tranzfort-network|careers|partner|contact|privacy|terms|cookies|legal-notice|login)/?$ index.html [END]
  RewriteRule ^blog(?:/[A-Za-z0-9-]+)?/?$ index.html [END]
  RewriteRule ^industries(?:/[A-Za-z0-9-]+)?/?$ index.html [END]
  RewriteRule ^resources(?:/[A-Za-z0-9-]+)?/?$ index.html [END]
</IfModule>

ErrorDocument 404 /index.html

# Prefer HTML sneak-peek pages over raw PDF URLs in search
<IfModule mod_headers.c>
  <FilesMatch "\.pdf$">
    Header set X-Robots-Tag "noindex, follow"
  </FilesMatch>
  Header set X-Robots-Tag "noindex, follow" env=NOINDEX
  # Do not let hCDN store slash 301s (that cache caused the /reports loop).
  Header always set Cache-Control "no-store" "expr=%{REQUEST_STATUS} =~ m#^30#"
</IfModule>

# Correct types for crawlers
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

# Optional: if a host still 500s on static sitemap.xml, uncomment:
# RewriteRule ^sitemap\.xml$ sitemap.php [L]
